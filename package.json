{
  "name": "financial-portfolio-manager",
  "version": "1.5.76",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node tests/run-tests.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "test:package": "node scripts/verify-package.cjs",
    "test:hours": "node tests/run-hours.cjs",
    "privacy:scan": "node scripts/privacy-scan.cjs",
    "test:desktop": "npm run build && node tests/run-desktop.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "npm run build && node tests/run-desktop.cjs",
    "validate": "node scripts/validate.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && node scripts/release.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "productName": "Financial Portfolio Manager",
  "description": "Desktop portfolio manager with KIS broker access and supervised AI trading.",
  "author": "goheungchoi",
  "build": {
    "appId": "com.goheungchoi.financial-portfolio-manager",
    "productName": "Financial Portfolio Manager",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "electron/**",
      "dist/**",
      "src/domain.mjs",
      "src/market.mjs",
      "scripts/agent-bridge.cjs",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Financial-Portfolio-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Financial Portfolio Manager"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "goheungchoi",
        "repo": "financial-portfolio-manager",
        "releaseType": "draft"
      }
    ]
  }
}
